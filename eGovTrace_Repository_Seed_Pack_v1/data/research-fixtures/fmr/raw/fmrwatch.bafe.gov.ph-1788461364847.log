(async () => {
  const frozen = window.__FMR_FROZEN_FRAME__;

  if (!frozen) {
    console.error(
      "STOP: __FMR_FROZEN_FRAME__ is not available in this page session."
    );
    console.error(
      "Do not proceed until the frozen frame is restored."
    );
    return;
  }

  console.log("========== FE7 R1 INDEPENDENT REPRODUCTION ==========");
  console.log("Frozen Frame ID:", frozen.frame_id);
  console.log("Frozen Record Count:", frozen.record_count);
  console.log("Frozen SHA-256:", frozen.sha256);

  const TOTAL_PAGES = 647;
  const EXPECTED_PROJECTS = 6467;
  const results = [];
  const allRecords = [];
  const seen = new Set();

  const uuidRegex =
    /\/projects\/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?:[?/"'\\])/gi;

  const reproductionStartedAt = new Date().toISOString();

  for (let page = 1; page <= TOTAL_PAGES; page++) {
    const url = `/projects?view=table&page=${page}`;

    try {
      const response = await fetch(url, {
        method: "GET",
        credentials: "same-origin",
        headers: {
          "Accept": "text/html,application/xhtml+xml"
        }
      });

      const text = await response.text();

      const pageIds = [...text.matchAll(uuidRegex)]
        .map(m => m[1].toLowerCase());

      const uniquePageIds = [...new Set(pageIds)];

      uniquePageIds.forEach((uuid, index) => {
        allRecords.push({
          page,
          position_on_page: index + 1,
          uuid
        });
        seen.add(uuid);
      });

      results.push({
        page,
        status: response.status,
        bytes: text.length,
        uuids_found: uniquePageIds.length,
        uuids: uniquePageIds
      });

      console.log(
        `R1 Page ${page}/${TOTAL_PAGES}:`,
        response.status,
        uniquePageIds.length,
        `UUIDs | total unique: ${seen.size}`
      );

      await new Promise(r => setTimeout(r, 250));

    } catch (err) {
      results.push({
        page,
        status: null,
        bytes: 0,
        uuids_found: 0,
        uuids: [],
        error: String(err)
      });

      console.error(`R1 Page ${page} failed:`, err);
    }
  }

  const reproductionFinishedAt = new Date().toISOString();

  // Build canonical ordered R1 frame.
  allRecords.sort((a, b) => {
    if (a.page !== b.page) return a.page - b.page;
    return a.position_on_page - b.position_on_page;
  });

  // Basic checks.
  const successfulPages =
    results.filter(x => x.status === 200).length;

  const failedPages =
    results.filter(x => x.status !== 200 || x.error).length;

  const enumeratedCount = allRecords.length;
  const uniqueCount = seen.size;

  // Compare against frozen frame exactly.
  const frozenRecords = frozen.frame.records || [];

  const differences = [];

  if (frozenRecords.length !== allRecords.length) {
    differences.push({
      type: "COUNT_MISMATCH",
      frozen: frozenRecords.length,
      reproduction: allRecords.length
    });
  }

  const compareLength = Math.max(
    frozenRecords.length,
    allRecords.length
  );

  for (let i = 0; i < compareLength; i++) {
    const a = frozenRecords[i];
    const b = allRecords[i];

    if (!a || !b) {
      differences.push({
        type: "MISSING_RECORD",
        index: i,
        frozen: a || null,
        reproduction: b || null
      });
      continue;
    }

    if (
      a.page !== b.page ||
      a.position_on_page !== b.position_on_page ||
      a.uuid !== b.uuid
    ) {
      differences.push({
        type: "RECORD_MISMATCH",
        index: i,
        frozen: a,
        reproduction: b
      });

      // Keep evidence manageable while still proving mismatch.
      if (differences.length >= 100) break;
    }
  }

  const exactMatch =
    successfulPages === TOTAL_PAGES &&
    failedPages === 0 &&
    enumeratedCount === EXPECTED_PROJECTS &&
    uniqueCount === EXPECTED_PROJECTS &&
    differences.length === 0;

  const r1 = {
    reproduction_id: `FE7-R1-${reproductionFinishedAt.replace(/[:.]/g, "-")}`,
    reproduction_started_at: reproductionStartedAt,
    reproduction_finished_at: reproductionFinishedAt,

    method:
      "Independent rerun of GET /projects?view=table&page=N using same-origin browser fetch and UUID extraction.",

    source:
      "https://fmrwatch.bafe.gov.ph/projects",

    pages_attempted: TOTAL_PAGES,
    successful_pages: successfulPages,
    failed_pages: failedPages,

    enumerated_records: enumeratedCount,
    unique_uuids: uniqueCount,
    expected_projects: EXPECTED_PROJECTS,

    frozen_frame_id: frozen.frame_id,
    frozen_sha256: frozen.sha256,
    frozen_record_count: frozen.record_count,

    exact_ordered_frame_match: exactMatch,
    differences_count: differences.length,
    differences,

    results,
    records: allRecords,

    final_status: exactMatch
      ? "PASS"
      : "NOT_MATCHING"
  };

  // IMPORTANT: frozen frame is NOT modified.
  window.__FMR_FE7_R1__ = r1;

  const blob = new Blob(
    [JSON.stringify(r1, null, 2)],
