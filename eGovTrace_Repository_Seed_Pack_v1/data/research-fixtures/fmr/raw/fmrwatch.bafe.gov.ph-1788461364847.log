(() => {
  const r = window.__FMR_FE2_RESULTS__;

  if (!r) {
    console.error("FE2 results not found in window.__FMR_FE2_RESULTS__");
    return;
  }

  const errors = [];

  // Basic totals
  if (r.total_pages_attempted !== 647)
    errors.push(`Expected 647 pages, got ${r.total_pages_attempted}`);

  if (r.successful_pages !== 647)
    errors.push(`Expected 647 successful pages, got ${r.successful_pages}`);

  if (r.failed_pages !== 0)
    errors.push(`Expected 0 failed pages, got ${r.failed_pages}`);

  if (r.expected_projects !== 6467)
    errors.push(`Expected project count 6467, got ${r.expected_projects}`);

  if (r.unique_uuids !== 6467)
    errors.push(`Expected 6467 unique UUIDs, got ${r.unique_uuids}`);

  // Page-by-page validation
  const pageMap = new Map();
  const allIds = [];

  for (const x of r.results) {
    pageMap.set(x.page, x);

    if (x.status !== 200)
      errors.push(`Page ${x.page}: HTTP ${x.status}`);

    allIds.push(...(x.uuids || []));
  }

  for (let page = 1; page <= 646; page++) {
    const x = pageMap.get(page);

    if (!x) {
      errors.push(`Missing page ${page}`);
      continue;
    }

    if (x.uuids_found !== 10)
      errors.push(`Page ${page}: expected 10 UUIDs, got ${x.uuids_found}`);
  }

  const last = pageMap.get(647);

  if (!last) {
    errors.push("Missing page 647");
  } else if (last.uuids_found !== 7) {
    errors.push(`Page 647: expected 7 UUIDs, got ${last.uuids_found}`);
  }

  // Duplicate test
  const unique = new Set(allIds);

  if (unique.size !== allIds.length) {
    errors.push(
      `Duplicate UUIDs detected: ${allIds.length - unique.size}`
    );
  }

  // Count reconciliation
  const enumeratedCount = allIds.length;

  if (enumeratedCount !== 6467)
    errors.push(`Enumerated UUID count = ${enumeratedCount}, expected 6467`);

  console.log("========== G3-FE VALIDATION ==========");
  console.log("Pages:", r.results.length);
  console.log("Successful pages:", r.successful_pages);
  console.log("Failed pages:", r.failed_pages);
  console.log("Enumerated UUIDs:", enumeratedCount);
  console.log("Unique UUIDs:", unique.size);
  console.log("Expected projects:", 6467);

  if (errors.length) {
    console.error("VALIDATION FAILED");
    console.error(errors);
    window.__FMR_FE2_VALIDATION__ = {
      status: "FAIL",
      errors
    };
    return;
  }

  console.log("VALIDATION PASSED");
  console.log("6467 / 6467 unique UUIDs");
  console.log("647 / 647 pages");
  console.log("0 failed pages");
  console.log("No duplicate UUIDs detected");

  window.__FMR_FE2_VALIDATION__ = {
    status: "PASS",
    pages: 647,
    enumerated: enumeratedCount,
    unique: unique.size,
    expected: 6467,
    duplicates: 0
  };
})();
