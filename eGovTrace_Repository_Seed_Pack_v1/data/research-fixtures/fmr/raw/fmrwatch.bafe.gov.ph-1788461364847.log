(async () => {
  const r = window.__FMR_FE2_RESULTS__;
  const v = window.__FMR_FE2_VALIDATION__;

  if (!r || !v || v.status !== "PASS") {
    console.error("FE2 validated results not found. Stop.");
    return;
  }

  // Flatten page records while preserving page membership.
  const records = [];

  for (const pageResult of r.results) {
    for (let i = 0; i < pageResult.uuids.length; i++) {
      records.push({
        page: pageResult.page,
        position_on_page: i + 1,
        uuid: pageResult.uuids[i].toLowerCase()
      });
    }
  }

  // Stable canonical ordering for reproducible hashing.
  records.sort((a, b) => {
    if (a.page !== b.page) return a.page - b.page;
    if (a.position_on_page !== b.position_on_page) {
      return a.position_on_page - b.position_on_page;
    }
    return a.uuid.localeCompare(b.uuid);
  });

  const frame = {
    frame_type: "FMR_WATCH_PUBLIC_PROJECT_FRAME",
    source: "https://fmrwatch.bafe.gov.ph/projects",
    portal_version_observed: "1.3.13",
    observed_project_count: 6467,
    pages: 647,
    page_size: 10,
    enumeration_method:
      "GET /projects?view=table&page=N via same-origin browser fetch; UUID extraction from returned project routes",
    validation_status: "PASS",
    records
  };

  const canonical = JSON.stringify(frame);

  const bytes = new TextEncoder().encode(canonical);
  const digest = await crypto.subtle.digest("SHA-256", bytes);

  const hash = [...new Uint8Array(digest)]
    .map(b => b.toString(16).padStart(2, "0"))
    .join("");

  const freeze = {
    frame_id: `FMR-FRAME-2026-09-03-${hash.slice(0, 12)}`,
    frozen_at: new Date().toISOString(),
    sha256: hash,
    record_count: records.length,
    page_count: 647,
    source: frame.source,
    portal_version_observed: frame.portal_version_observed,
    frame
  };

  window.__FMR_FROZEN_FRAME__ = freeze;

  // Download immutable snapshot.
  const blob = new Blob(
    [JSON.stringify(freeze, null, 2)],
    { type: "application/json" }
  );

  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "FMR_Watch_Frozen_Frame_6467_2026-09-03.json";
  document.body.appendChild(a);
  a.click();
  a.remove();

  console.log("========== G3-FE FRAME FREEZE ==========");
  console.log("FRAME ID:", freeze.frame_id);
  console.log("Frozen at:", freeze.frozen_at);
  console.log("Records:", freeze.record_count);
  console.log("Pages:", freeze.page_count);
  console.log("SHA-256:", freeze.sha256);
  console.log("STATUS: FRAME FROZEN");
})();
