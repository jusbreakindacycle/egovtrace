Warning: Don’t paste code into the DevTools Console that you don’t understand or haven’t reviewed yourself. This could allow attackers to steal your identity or take control of your computer. Please type “allow pasting” below and press Enter to allow pasting.
allow pasting
(async () => {
  const TOTAL_PAGES = 647;
  const results = [];
  const seen = new Set();

  const uuidRegex =
    /\/projects\/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?:[?/"'\\\\])/gi;

  for (let page = 1; page <= TOTAL_PAGES; page++) {
    const url = `/projects?view=table&page=${page}`;

    try {
      const response = await fetch(url, {
        method: "GET",
        credentials: "same-origin",
        headers: {
          "Accept": "text/html,application/xhtml+xml"
        }
      });

      const text = await response.text();

      const pageIds = [...text.matchAll(uuidRegex)]
        .map(m => m[1].toLowerCase());

      const uniquePageIds = [...new Set(pageIds)];

      for (const id of uniquePageIds) {
        seen.add(id);
      }

      results.push({
        page,
        status: response.status,
        bytes: text.length,
        uuids_found: uniquePageIds.length,
        uuids: uniquePageIds
      });

      console.log(
        `Page ${page}/${TOTAL_PAGES}:`,
        response.status,
        uniquePageIds.length,
        `UUIDs | total unique: ${seen.size}`
      );

      // Be polite to the public server.
      await new Promise(r => setTimeout(r, 250));

    } catch (err) {
      results.push({
        page,
        error: String(err),
        uuids_found: 0,
        uuids: []
      });

      console.error(`Page ${page} failed`, err);
    }
  }

  const summary = {
    total_pages_attempted: TOTAL_PAGES,
    successful_pages: results.filter(x => x.status === 200).length,
    failed_pages: results.filter(x => x.status !== 200 || x.error).length,
    unique_uuids: seen.size,
    expected_projects: 6467,
    results
  };

  window.__FMR_FE2_RESULTS__ = summary;

  console.log("========== FE2 SUMMARY ==========");
  console.log(summary);

  // Download locally as JSON.
  const blob = new Blob(
    [JSON.stringify(summary, null, 2)],
    { type: "application/json" }
  );

  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "FMR_Watch_FE2_Enumeration.json";
  a.click();

  console.log(
    `DONE. Unique UUIDs found: ${seen.size} / expected 6467`
  );
})();
